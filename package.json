{
  "name": "@proveitbro/engine",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Browser-first Plinko mathematics, provably fair replay adapters and deterministic session simulations.",
  "exports": {
    ".": "./src/index.ts",
    "./plinko": "./src/games/plinko/index.ts",
    "./sim": "./src/sim/index.ts",
    "./input": "./src/core/input.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test 'src/**/*.test.ts'",
    "test": "npm run typecheck && npm run test:unit && npm run test:release && npm run test:examples",
    "security:check": "node scripts/security-check.mjs",
    "security:audit": "npm audit --package-lock-only --audit-level=high",
    "test:release": "node scripts/check-release.mjs",
    "test:examples": "node examples/verify-stake.ts && node examples/verify-bch-games.ts",
    "security:history": "node scripts/check-history.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "homepage": "https://provablyhero.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvablyHero/engine.git"
  },
  "bugs": {
    "url": "https://github.com/ProvablyHero/engine/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
